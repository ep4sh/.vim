# --- Ornith (q8_0, ctx 32768) ---
llama_serve_ornith_q8() {
  echo "[llama] starting: ornith-ai/Ornith-1.5-9B-GGUF:Q8_K_M (q8_0, ctx 32768)"
  llama serve -hf ornith-ai/Ornith-1.5-9B-GGUF:Q8_0 -fa on -ctk q8_0 -ctv q8_0 \
             --temperature 0.6 --top_p 0.95 --top_k 20 --min_p 0.0 \
             --presence-penalty 0.0 --repeat-penalty 1.0 \
             --ctx_size 32768
}

# --- LiquidAI/LFM2.5-2.6B ---
llama_serve_lfm() {
  echo "[llama] starting: LiquidAI/LFM2.5-2.6B-GGUF"
  llama serve -hf LiquidAI/LFM2.5-2.6B-GGUF --temp 0.1 --top-k 50 --repeat-penalty 1.1 --no-ui --agent --tools all --gpu-layers all -np 1 --ctx_size 4096 --port 9932
}

# --- Tesslate/OmniCoder-9B ---
llama_serve_omnicoder() {
  echo "[llama] starting: Tesslate/OmniCoder-9B-GGUF (q8_0, ctx 65545)"
  llama serve -hf Tesslate/OmniCoder-9B-GGUF -fa on -ctk q8_0 -ctv q8_0 \
             --no-ui --agent --tools all --gpu-layers all -np 1 \
             --temperature 0.6 --top_p 0.95 --top_k 20 --min_p 0.0 \
             --presence-penalty 0.0 --repeat-penalty 1.0 \
             -n 1 -cb --ctx_size 40000
}
